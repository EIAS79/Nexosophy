FROM node:24.21.0-bookworm-slim
ENV NODE_ENV=production
ENV PORT=4300
WORKDIR /srv/media
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates clamav clamav-freshclam file ffmpeg poppler-utils libreoffice-core \
      libreoffice-writer libreoffice-calc libreoffice-impress && \
    update-ca-certificates && rm -rf /var/lib/apt/lists/*
COPY infra/media-service/server.mjs ./server.mjs
# Never mark unscanned files clean when signature database is unavailable.
# Freshclam failures leave /ready at 503 and scanning fails closed.
CMD ["sh", "-c", "(freshclam --quiet || true; freshclam -d --quiet || true) & exec node /srv/media/server.mjs"]
