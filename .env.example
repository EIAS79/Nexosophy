NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# API
API_HOST=0.0.0.0
API_PORT=4000

# Worker health server
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4200
WORKER_CONCURRENCY=5

# Realtime service
REALTIME_HOST=0.0.0.0
REALTIME_PORT=4100

# Data
DATABASE_URL=postgresql://nexosophy:nexosophy@localhost:5432/nexosophy
REDIS_URL=redis://localhost:6379

# Clerk (configure per environment)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe (configure per environment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability
OTEL_SERVICE_NAME=nexosophy-local
OTEL_EXPORTER_OTLP_ENDPOINT=
