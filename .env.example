NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# API
API_HOST=0.0.0.0
API_PORT=4000

# Worker health server
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4200
WORKER_CONCURRENCY=5

# Realtime service
REALTIME_HOST=0.0.0.0
REALTIME_PORT=4100

# Data
DATABASE_URL=postgresql://nexosophy:nexosophy@localhost:5432/nexosophy
REDIS_URL=redis://localhost:6379
DB_POOL_MAX=10

# Authentication — Clerk
# Never commit real values. Configure these in local/deployment secret storage.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXOSOPHY_API_URL=http://127.0.0.1:4000


# Stripe (configure per environment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability
OTEL_SERVICE_NAME=nexosophy-local
OTEL_EXPORTER_OTLP_ENDPOINT=


# Private S3-compatible object storage (AWS S3, Cloudflare R2, or compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# Worker-side security/conversion services. These services receive short-lived
# signed object URLs; file bytes do not transit the Nexosophy API.
MALWARE_SCANNER_URL=
MEDIA_PROCESSOR_URL=


# Realtime collaboration gateway
REALTIME_PUBLIC_URL=ws://localhost:4100
REALTIME_TOKEN_SECRET=change-me-to-a-random-secret-at-least-32-characters
REALTIME_MAX_ROOM_CONNECTIONS=200
REALTIME_MAX_MESSAGE_BYTES=262144


# Optional outbound notification providers. The worker sends a small redacted
# delivery envelope; provider credentials stay behind these internal services.
NOTIFICATION_EMAIL_URL=
NOTIFICATION_PUSH_URL=
