NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# API
API_HOST=0.0.0.0
API_PORT=4000

# Worker health server
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4200
WORKER_CONCURRENCY=5

# Realtime service
REALTIME_HOST=0.0.0.0
REALTIME_PORT=4100

# Data
DATABASE_URL=postgresql://nexosophy:nexosophy@localhost:5432/nexosophy
REDIS_URL=redis://localhost:6379
DB_POOL_MAX=10

# Self-hosted Nexosophy authentication — never commit real credentials.
# All values belong in provider secret storage, with separate staging/production keys.
NEXOSOPHY_AUTH_SECRET=
NEXOSOPHY_AUTH_URL=http://localhost:3000
NEXOSOPHY_AUTH_TRUSTED_ORIGINS=http://localhost:3000
NEXOSOPHY_API_URL=http://127.0.0.1:4000
# Email delivery (required for verification/recovery).
NEXOSOPHY_EMAIL_API_KEY=
NEXOSOPHY_EMAIL_FROM=
# OAuth providers (configure each complete client-ID/secret pair).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=


# Stripe (configure per environment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability
OTEL_SERVICE_NAME=nexosophy-local
OTEL_EXPORTER_OTLP_ENDPOINT=


# Private S3-compatible object storage (AWS S3, Cloudflare R2, or compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# Worker-side security/conversion services. These services receive short-lived
# signed object URLs; file bytes do not transit the Nexosophy API.
MALWARE_SCANNER_URL=
MEDIA_PROCESSOR_URL=


# Realtime collaboration gateway
REALTIME_PUBLIC_URL=ws://localhost:4100
REALTIME_TOKEN_SECRET=change-me-to-a-random-secret-at-least-32-characters
REALTIME_MAX_ROOM_CONNECTIONS=200
REALTIME_MAX_MESSAGE_BYTES=262144


# Optional outbound notification providers. The worker sends a small redacted
# delivery envelope; provider credentials stay behind these internal services.
NOTIFICATION_EMAIL_URL=
NOTIFICATION_PUSH_URL=
# External integrations
INTEGRATION_OAUTH_CALLBACK_BASE_URL=http://localhost:4000
INTEGRATION_WEB_RETURN_BASE_URL=http://localhost:3000
INTEGRATION_WEBHOOK_BASE_URL=
# key-id:base64-32-byte-key; comma-separated. First key encrypts new secrets.
INTEGRATION_ENCRYPTION_KEYS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MENDELEY_OAUTH_CLIENT_ID=
MENDELEY_OAUTH_CLIENT_SECRET=

# Office editing is disabled until an operator-approved provider is configured.
OFFICE_PROVIDER=disabled
OFFICE_PROVIDER_URL=
OFFICE_CALLBACK_BASE_URL=http://localhost:4000
OFFICE_PROVIDER_JWT_SECRET=
