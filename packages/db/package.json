{
  "name": "@nexosophy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "clean": "rm -rf dist",
    "db:migrate": "tsx src/migrate.ts",
    "test:identity-integration": "tsx src/identity-integration.ts",
    "test:workspace-integration": "tsx src/workspace-integration.ts",
    "test:content-integration": "tsx src/content-integration.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}