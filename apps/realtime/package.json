{
  "name": "@nexosophy/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown src/index.ts --format esm --platform node --sourcemap --clean",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nexosophy/config": "workspace:*",
    "@nexosophy/observability": "workspace:*",
    "fastify": "5.12.5",
    "redis": "6.3.0"
  }
}
